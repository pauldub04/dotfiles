# wget from nirvana
nwget() {
  wget --header="Authorization: OAuth `cat /home/$USER/.nirvana/token`" --no-check-certificate -N --content-disposition "$@"
}

# The next line updates PATH for CLI.
if [ -f '/home/pdubnyakov/yandex-cloud/path.bash.inc' ]; then source '/home/pdubnyakov/yandex-cloud/path.bash.inc'; fi

# The next line enables shell command completion for yc.
if [ -f '/home/pdubnyakov/yandex-cloud/completion.zsh.inc' ]; then source '/home/pdubnyakov/yandex-cloud/completion.zsh.inc'; fi
